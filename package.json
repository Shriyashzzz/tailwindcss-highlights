{
  "name": "tailwindcss-highlights-v4",
  "version": "1.0.0",
  "description": "A tailwindcss plugin to add highlights to your text (Tailwind v4-compatible fork)",
  "repository": "https://github.com/Shriyashzzz/tailwindcss-highlights",
  "keywords": [
    "plugin",
    "tailwind",
    "tailwindcss",
    "tailwindcss-plugin",
    "tailwindcss-v4",
    "highlights",
    "marks",
    "brushes"
  ],
  "author": "Julian Hubatsch (original author, https://github.com/jln13x)",
  "contributors": [
    "Shriyashzzz (v4 compatibility fork, https://github.com/Shriyashzzz)"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/Shriyashzzz/tailwindcss-highlights/issues"
  },
  "homepage": "https://github.com/Shriyashzzz/tailwindcss-highlights#readme",
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "publish": "npm run build && npm publish",
    "optimize": "svgo -f ./highlights -o ./highlights"
  },
  "peerDependencies": {
    "tailwindcss": "^3.1.8 || ^4.0.0"
  },
  "devDependencies": {
    "svgo": "^2.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^4.9.5"
  }
}
